<Page
    x:Class="MultiWave.MainPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MultiWave.Models">

    <Grid Background="#0B0E13">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.RowSpan="2" Background="#100F11" BorderBrush="#30241D" BorderThickness="0,0,1,0" Padding="16,22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="4" Margin="8,4,0,28">
                    <TextBlock Text="∿" FontSize="48" FontWeight="Light" Foreground="#FF9A32" HorizontalAlignment="Center"/>
                    <TextBlock Text="MULTIWAVE" FontSize="22" FontWeight="Bold" Foreground="#F5F7FA" HorizontalAlignment="Center"/>
                    <TextBlock Text="One Source. Every Speaker." FontSize="10" Foreground="#A9A2A0" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="NavigationMenu" Grid.Row="1" Spacing="7">
                    <Button x:Name="NavigationDashboardButton" Tag="Dashboard" Content="⌂   Dashboard" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="14,12" Background="#492817" Foreground="#FFAA54"/>
                    <Button x:Name="NavigationEqualizerButton" Tag="Equalizer" Content="☷   Equalizer" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="14,12" Background="Transparent" Foreground="#C4C0C2"/>
                    <Button x:Name="NavigationEffectsButton" Tag="Effects" Content="✣   Effects" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="14,12" Background="Transparent" Foreground="#C4C0C2"/>
                    <Button x:Name="NavigationSyncButton" Tag="Synchronization" Content="⟳   Synchronization" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="14,12" Background="Transparent" Foreground="#C4C0C2"/>
                    <Button x:Name="NavigationSettingsButton" Tag="Settings" Content="⚙   Settings" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="14,12" Background="Transparent" Foreground="#C4C0C2"/>
                    <Button x:Name="NavigationAboutButton" Tag="About" Content="ⓘ   About" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Padding="14,12" Background="Transparent" Foreground="#C4C0C2"/>
                </StackPanel>
                <Border Grid.Row="2" Background="#191719" BorderBrush="#35261D" BorderThickness="1" CornerRadius="12" Padding="12">
                    <StackPanel Spacing="5"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="9" Height="9" Fill="#55D878" VerticalAlignment="Center"/><TextBlock Text="Audio Engine" Foreground="#E8E6E6" FontSize="12"/></StackPanel><TextBlock x:Name="SidebarEngineStatus" Text="Stopped" Foreground="#FF9A32" Margin="17,0,0,0"/><TextBlock Text="MultiWave · Windows Audio" FontSize="9" Foreground="#777274" Margin="17,2,0,0"/></StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Header -->

        <Border
            Grid.Row="0"
            Grid.Column="1"
            Background="#111722"
            Padding="28,20"
            BorderBrush="#252D3A"
            BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock
                        Text="Intelligent Multi-Speaker Audio"
                        FontSize="23"
                        FontWeight="SemiBold"
                        Foreground="#F5F7FA"/>

                    <TextBlock
                        Text="Auto-optimized. Synchronized. Tuned to your setup."
                        FontSize="13"
                        Foreground="#8995A8"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button
                        Content="↻  Refresh"
                        Click="RefreshButton_Click"
                        Background="#222C3A"
                        Foreground="White"
                        Padding="14,10"
                        CornerRadius="9"/>
                    <Button
                        x:Name="StartDuplicationButton"
                        Content="Start System Audio"
                        Click="StartDuplicationButton_Click"
                        Background="#FF9A52"
                        Foreground="#111722"
                        FontWeight="SemiBold"
                        Padding="16,10"
                        CornerRadius="9"/>
                    <Button
                        Content="Stop"
                        Click="StopDuplicationButton_Click"
                        Background="#222C3A"
                        Foreground="White"
                        Padding="14,10"
                        CornerRadius="9"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Main dashboard -->

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">

            <StackPanel Padding="28"
                        Spacing="22">

                <StackPanel Spacing="6">
                    <TextBlock
                        Text="Audio Dashboard"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="#F5F7FA"/>

                    <TextBlock
                        Text="Manage selected speakers, sound shaping and timing."
                        FontSize="14"
                        Foreground="#8995A8"/>
                </StackPanel>

                <Border Background="#1A1513" BorderBrush="#7A3B18" BorderThickness="1" CornerRadius="16" Padding="18">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid ColumnSpacing="14" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="◖))" FontSize="28" Foreground="#FF9A32" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="MASTER VOLUME" FontSize="11" FontWeight="SemiBold" Foreground="#FFB36B"/><TextBlock Text="Control all selected speakers" FontSize="12" Foreground="#C7C0BE"/></StackPanel>
                            <Slider x:Name="MasterVolumeSlider" Grid.Column="1" Margin="0,42,44,0" Minimum="0" Maximum="100" Value="70" ValueChanged="MasterVolumeSlider_ValueChanged" AutomationProperties.Name="MultiWave master volume"/>
                            <TextBlock x:Name="MasterVolumeText" Grid.Column="2" Text="70%" Foreground="#F5F7FA" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        </Grid>
                        <Button Grid.Column="1" x:Name="MasterMuteButton" Content="Mute" Click="MasterMuteButton_Click" Background="#22252B" Foreground="#E8E6E6" Padding="16,12" CornerRadius="10" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Content="✦  Auto Optimize" Click="AutoOptimizeButton_Click" Background="#FF922A" Foreground="#21160E" FontWeight="SemiBold" Padding="18,14" CornerRadius="10"/>
                            <Border Background="#202126" CornerRadius="10" Padding="14,8">
                                <StackPanel Spacing="2"><StackPanel Orientation="Horizontal" Spacing="9"><TextBlock Text="Auto Sync" Foreground="#F5F7FA" VerticalAlignment="Center"/><ToggleSwitch x:Name="AutoSyncToggle" IsOn="True" Toggled="AutoSyncToggle_Toggled" AutomationProperties.Name="WASAPI renderer latency alignment"/></StackPanel><TextBlock x:Name="AutoSyncSummaryText" Text="Offsets reported WASAPI latency only" FontSize="9" Foreground="#8995A8"/></StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Device section -->

                <Border
                    Background="#111722"
                    BorderBrush="#252D3A"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="22">

                    <StackPanel Spacing="18">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    Text="PLAYBACK ENDPOINTS"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#8995A8"/>

                                <TextBlock
                                    x:Name="CountText"
                                    Text="Detecting devices..."
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="#F5F7FA"/>
                                <TextBlock
                                    x:Name="SelectedCountText"
                                    Text="0 selected"
                                    FontSize="12"
                                    Foreground="#8995A8"/>
                            </StackPanel>

                            <TextBlock
                                x:Name="StatusText"
                                Grid.Column="1"
                                Text="Initializing"
                                Foreground="#A7B3C5"
                                VerticalAlignment="Center"
                                FontSize="12"/>
                        </Grid>

                        <TextBlock
                            x:Name="RoutingHintText"
                            Text="Selected-only routing requires Windows and each app to send audio to a virtual capture endpoint. Choose that endpoint above, then select only the physical speakers. MultiWave never changes your Windows default device."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="#A7B3C5"/>

                        <TextBlock
                            Text="Auto headroom and soft limiting reduce digital clipping. Movie adds light dialogue presence; Music uses a balanced tone. Physical speaker distortion still depends on its hardware and volume."
                            TextWrapping="Wrap"
                            FontSize="11"
                            Foreground="#8995A8"/>

                        <ListView
                            x:Name="DeviceList"
                            SelectionMode="None"
                            IsItemClickEnabled="False"
                            Background="Transparent"
                            BorderThickness="0">

                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:AudioDeviceViewModel">
                                    <Border
                                        Background="#19212D"
                                        CornerRadius="11"
                                        Padding="16"
                                        Margin="0,0,0,9">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="240"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox
                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Select playback device"/>

                                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="9">
                                                    <TextBlock
                                                        Text="{x:Bind FriendlyName}"
                                                        FontSize="15"
                                                        FontWeight="SemiBold"
                                                        Foreground="#F5F7FA"
                                                        TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock
                                                        Text="{x:Bind DefaultLabel}"
                                                        FontSize="10"
                                                        FontWeight="Bold"
                                                        Foreground="#FF9A52"
                                                        VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock
                                                    Text="{x:Bind DeviceId}"
                                                    FontSize="10"
                                                    Foreground="#8995A8"
                                                    TextTrimming="CharacterEllipsis"/>
                                                <TextBlock
                                                    Text="{x:Bind CapabilitiesLabel}"
                                                    FontSize="10"
                                                    Foreground="#718096"
                                                    TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind RendererLatencyLabel, Mode=OneWay}" FontSize="10" Foreground="#FFB36B" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind AutoCompensationLabel, Mode=OneWay}" FontSize="10" Foreground="#A7B3C5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind QueueLabel, Mode=OneWay}" FontSize="10" Foreground="#A7B3C5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind UnderrunLabel, Mode=OneWay}" FontSize="10" Foreground="#8995A8" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="76"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="38"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Device" FontSize="10" Foreground="#8995A8" VerticalAlignment="Center"/>
                                                    <Slider
                                                        Grid.Column="1"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="{x:Bind Volume, Mode=TwoWay}"
                                                        ValueChanged="DeviceVolumeSlider_ValueChanged"
                                                        AutomationProperties.Name="Windows endpoint volume"/>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind Volume, Mode=OneWay}"
                                                        FontSize="11"
                                                        Foreground="#D7DEE8"
                                                        VerticalAlignment="Center"/>
                                                </Grid>
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="76"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="38"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="MultiWave" FontSize="10" Foreground="#FFB77F" VerticalAlignment="Center"/>
                                                    <Slider
                                                        Grid.Column="1"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="{x:Bind StreamVolume, Mode=TwoWay}"
                                                        IsEnabled="{x:Bind CanSetStreamVolume}"
                                                        AutomationProperties.Name="MultiWave stream volume"/>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{x:Bind StreamVolume, Mode=OneWay}"
                                                        FontSize="11"
                                                        Foreground="#D7DEE8"
                                                        VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock
                                                    Text="{x:Bind VolumeStatus, Mode=OneWay}"
                                                    FontSize="10"
                                                    Foreground="#8995A8"
                                                    TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Ellipse Width="8" Height="8" Fill="#55D6A2" VerticalAlignment="Center"/>
                                                <TextBlock
                                                    Text="{x:Bind StateLabel}"
                                                    FontSize="11"
                                                    Foreground="#A7B3C5"
                                                    VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                        </ListView>

                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="DiagnosticsSection" Background="#111722" BorderBrush="#302D31" BorderThickness="1" CornerRadius="16" Padding="18">
                        <StackPanel Spacing="9"><TextBlock Text="REAL-TIME AUDIO DIAGNOSTICS" FontSize="11" FontWeight="SemiBold" Foreground="#FF9A32"/><TextBlock x:Name="DiagnosticsEngineText" Text="Audio engine stopped · no live stream measurements" FontSize="15" FontWeight="SemiBold" Foreground="#F5F7FA"/><TextBlock x:Name="DiagnosticsLatencyText" Text="WASAPI latency: unavailable" Foreground="#DAD5D3"/><TextBlock x:Name="DiagnosticsQueueText" Text="Output queues: unavailable" Foreground="#DAD5D3"/><TextBlock x:Name="DiagnosticsUnderrunText" Text="Underruns / overflows: unavailable" Foreground="#DAD5D3"/><TextBlock Text="Bluetooth acoustic latency and shared hardware clock accuracy are not exposed by Windows Core Audio." FontSize="10" Foreground="#8995A8" TextWrapping="Wrap"/></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#111722" BorderBrush="#302D31" BorderThickness="1" CornerRadius="16" Padding="18">
                        <StackPanel Spacing="8"><TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="#FF9A32"/><Button Content="Reset EQ, trims &amp; delays" Click="ResetAllSettingsButton_Click" HorizontalContentAlignment="Left" Background="#202126" Foreground="#F5F7FA" Padding="12,9"/><Button Content="Open calibration" Click="CalibrationQuickAction_Click" HorizontalContentAlignment="Left" Background="#202126" Foreground="#F5F7FA" Padding="12,9"/><Button Content="View diagnostics" Click="DiagnosticsButton_Click" HorizontalContentAlignment="Left" Background="#202126" Foreground="#F5F7FA" Padding="12,9"/></StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="EqualizerSection" Background="#111722" BorderBrush="#302D31" BorderThickness="1" CornerRadius="16" Padding="18">
                    <StackPanel Spacing="12">
                        <TextBlock Text="AUDIO WORKSPACE" FontSize="11" FontWeight="SemiBold" Foreground="#FF9A52"/>
                        <Pivot x:Name="MainFeatureTabs" Background="Transparent">
                            <PivotItem Header="Equalizer">
                                <StackPanel Spacing="12" Padding="8,12,8,18">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <CheckBox Content="Global EQ" IsChecked="{x:Bind GlobalEqualizer.Enabled, Mode=TwoWay}" Foreground="#F5F7FA"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{x:Bind GlobalEqualizer.PresetOptions}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{x:Bind GlobalEqualizer.SelectedPresetKey, Mode=TwoWay}" AutomationProperties.Name="Global equalizer preset"/>
                                        <TextBlock Grid.Column="2" Text="PREAMP" Foreground="#8995A8" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="3" Minimum="-12" Maximum="12" Value="{x:Bind GlobalEqualizer.PreampDb, Mode=TwoWay}" AutomationProperties.Name="Global EQ preamp"/>
                                    </Grid>
                                    <Canvas x:Name="GlobalResponseCanvas" Height="126" Background="#17191F" SizeChanged="GlobalResponseCanvas_SizeChanged">
                                        <Polyline x:Name="GlobalResponseCurve" Stroke="#FF9A32" StrokeThickness="2"/>
                                    </Canvas>
                                    <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="GlobalEqualizerBands" ItemsSource="{x:Bind GlobalEqualizer.Bands}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:EqualizerBandViewModel"><StackPanel Width="52"><TextBlock Text="{x:Bind FrequencyLabel}" Foreground="#A7B3C5"/><Slider Orientation="Vertical" Height="80" Minimum="-12" Maximum="12" Value="{x:Bind GainDb, Mode=TwoWay}"/><TextBlock Text="{x:Bind GainLabel}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="Selected speaker equalizers" Foreground="#FF9A52"/>
                                    <ItemsControl x:Name="DeviceEqualizerList" ItemsSource="{x:Bind SelectedOutputDevices}">
                                        <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:AudioDeviceViewModel"><TextBlock Text="{x:Bind FriendlyName}" Foreground="#F5F7FA"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </PivotItem>
                            <PivotItem Header="Spectrum Analyzer">
                                <TextBlock Text="The visualizer waits for live capture samples." Foreground="#A7B3C5" Padding="8,18"/>
                            </PivotItem>
                            <PivotItem Header="Audio Effects">
                                <StackPanel Spacing="8" Padding="8,18">
                                    <TextBlock Text="Bass shelf" Foreground="#F5F7FA"/>
                                    <Slider Minimum="-12" Maximum="12" Value="{x:Bind GlobalEqualizer.BassDb, Mode=TwoWay}"/>
                                    <TextBlock Text="Treble shelf" Foreground="#F5F7FA"/>
                                    <Slider Minimum="-12" Maximum="12" Value="{x:Bind GlobalEqualizer.TrebleDb, Mode=TwoWay}"/>
                                </StackPanel>
                            </PivotItem>
                        </Pivot>
                    </StackPanel>
                </Border>

                <Border x:Name="SynchronizationSection" Background="#111722" BorderBrush="#252D3A" BorderThickness="1" CornerRadius="16" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="AUDIO SYNCHRONIZATION" FontSize="11" FontWeight="SemiBold" Foreground="#FF9A52"/>
                        <TextBlock Text="Manual speaker calibration" FontSize="19" FontWeight="SemiBold" Foreground="#F5F7FA"/>
                        <TextBlock Text="Add delay to earlier sounding speakers (0–500 ms). Per-device buffer capacity is configurable (80–500 ms) and applied when streams start. Windows reports renderer latency, but Bluetooth acoustic latency and hardware clock drift are not reliably exposed. Use a tone and listening test for manual calibration." TextWrapping="Wrap" FontSize="12" Foreground="#8995A8"/>
                        <TextBlock Text="AUTOMATIC ACOUSTIC CALIBRATION" FontSize="10" FontWeight="SemiBold" Foreground="#FF9A52" Margin="0,4,0,0"/>
                        <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="CalibrationMicrophoneComboBox" DisplayMemberPath="FriendlyName" SelectedValuePath="DeviceId" SelectionChanged="CalibrationMicrophoneComboBox_SelectionChanged" Background="#19212D" Foreground="#F5F7FA" AutomationProperties.Name="Microphone for acoustic calibration"/>
                            <Button x:Name="AutomaticCalibrationButton" Grid.Column="1" Content="Measure &amp; Calibrate" Click="AutomaticCalibrationButton_Click" Background="#FF963D" Foreground="#111722" Padding="14,8" CornerRadius="8"/>
                        </Grid>
                        <TextBlock Text="Uses the selected real microphone and a quiet-room swept tone played one speaker at a time. Keep the microphone at the listening position. This measures relative acoustic arrival; it is not an absolute Bluetooth latency or clock measurement. Microphone privacy permission may be required." TextWrapping="Wrap" FontSize="11" Foreground="#A7B3C5"/>
                        <Button Content="Reset selected delays to 0 ms" Click="ResetDelaysButton_Click" HorizontalAlignment="Left" Background="#222C3A" Foreground="White" Padding="12,8" CornerRadius="8"/>
                        <Button Content="Play 1 kHz calibration tone (2 seconds)" Click="CalibrationToneButton_Click" HorizontalAlignment="Left" Background="#222C3A" Foreground="#FFB77F" Padding="12,8" CornerRadius="8"/>
                        <ItemsControl x:Name="SynchronizationList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:AudioDeviceViewModel">
                                    <Border Background="#19212D" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                        <Grid ColumnSpacing="12" RowSpacing="8">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Text="{x:Bind FriendlyName}" Foreground="#F5F7FA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="500" Value="{x:Bind DelayMilliseconds, Mode=TwoWay}" ValueChanged="DelaySlider_ValueChanged" AutomationProperties.Name="Speaker synchronization delay"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{x:Bind DelayMilliseconds, Mode=OneWay}" Foreground="#D7DEE8" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind CalibrationLabel, Mode=OneWay}" Foreground="#8995A8" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Text="Buffer ms" FontSize="10" Foreground="#8995A8" VerticalAlignment="Center"/>
                                            <Slider Grid.Row="1" Grid.Column="1" Minimum="80" Maximum="500" Value="{x:Bind BufferMilliseconds, Mode=TwoWay}" ValueChanged="BufferSlider_ValueChanged" AutomationProperties.Name="Device buffer capacity"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{x:Bind BufferMilliseconds, Mode=OneWay}" Foreground="#D7DEE8" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Saved calibration is stored per Windows endpoint in local JSON preferences. The delay line is live adjustable and crossfades changes to reduce clicks." TextWrapping="Wrap" FontSize="11" Foreground="#8995A8"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SettingsSection" Background="#111722" BorderBrush="#252D3A" BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="12"><TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold" Foreground="#FF9A32"/><TextBlock Text="Audio source and output tone" FontSize="19" FontWeight="SemiBold" Foreground="#F5F7FA"/><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="Capture source" Foreground="#A7B3C5" VerticalAlignment="Center"/><ComboBox x:Name="CaptureSourceComboBox" Grid.Column="1" DisplayMemberPath="FriendlyName" SelectedValuePath="DeviceId" SelectionChanged="CaptureSourceComboBox_SelectionChanged" Background="#19212D" Foreground="#F5F7FA" AutomationProperties.Name="System audio capture source"/><TextBlock Grid.Column="2" Text="Output tone" Foreground="#A7B3C5" VerticalAlignment="Center"/><ComboBox x:Name="AudioPresetComboBox" Grid.Column="3" SelectedIndex="1" SelectionChanged="AudioPresetComboBox_SelectionChanged" Background="#19212D" Foreground="#F5F7FA" AutomationProperties.Name="Output tone"><ComboBoxItem Content="Movie" Tag="Movie"/><ComboBoxItem Content="Music" Tag="Music"/></ComboBox></Grid><TextBlock Text="For selected-only routing, set Windows and each app output to a separate virtual capture endpoint and select it here. WASAPI loopback is a tap and MultiWave does not change Windows routing." FontSize="11" Foreground="#8995A8" TextWrapping="Wrap"/></StackPanel>
                </Border>
                <Border x:Name="AboutSection" Background="#111722" BorderBrush="#252D31" BorderThickness="1" CornerRadius="16" Padding="20">
                    <StackPanel Spacing="6"><TextBlock Text="ABOUT MULTIWAVE" FontSize="11" FontWeight="SemiBold" Foreground="#FF9A32"/><TextBlock Text="One Source. Every Speaker." FontSize="19" FontWeight="SemiBold" Foreground="#F5F7FA"/><TextBlock Text="Native Windows audio · .NET 10 · WinUI 3 · NAudio WASAPI" FontSize="12" Foreground="#A7B3C5"/><TextBlock Text="Renderer timing is reported by Windows. Bluetooth acoustic latency and speaker capabilities are not inferred or fabricated." FontSize="11" Foreground="#8995A8" TextWrapping="Wrap"/></StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</Page>
